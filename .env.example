APP__HOST=0.0.0.0
APP__PORT=8000

DB__NAME=payments
DB__USER=postgres
DB__PASSWORD=postgres
DB__HOST=localhost
DB__PORT=5432
DB__DRIVER_NAME=postgresql+asyncpg

BROKER__URL=amqp://guest:guest@localhost:5672/
BROKER__RESULT_BACKEND=rpc://

POOL__ECHO=false
POOL__POOL_PRE_PING=true
POOL__POOL_SIZE=5
POOL__MAX_OVERFLOW=10

WEBHOOK__MAX_ATTEMPTS=3
WEBHOOK__BASE_DELAY_SECONDS=2
WEBHOOK__TIMEOUT_SECONDS=10

OUTBOX__BASE_RETRY_DELAY_SECONDS=3
OUTBOX__MAX_ATTEMPTS=3
OUTBOX__MAX_CONSUMER_RETRIES=3

PAYMENT__EXCHANGE_NAME=payments
PAYMENT__DLX_NAME=payments.dlx
PAYMENT__NEW_ROUTE=payments.new
PAYMENT__RETRY_ROUTE=payments.new.retry
PAYMENT__DLQ_ROUTE=payments.new.dlq
PAYMENT__RETRY_DELAY_MS=10000
PAYMENT__NEW_TOPIC=payments.new

RABBIT_USER=guest
RABBIT_PASSWORD=guest
API_KEY=test-api-key
